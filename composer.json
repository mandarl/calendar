{
    "name": "calendar/app",
    "description": "CakePHP DMS calendar app",
    "homepage": "https://calendar.example.test",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "ext-ldap": "*",
        "cakephp/cakephp": "^5.4",
        "cakephp/authentication": "^4.0",
        "cakephp/authorization": "^3.0",
        "cakephp/migrations": "^5.0",
        "friendsofcake/crud": "^7.0",
        "friendsofcake/cakephp-csvview": "^5.0",
        "josegonzalez/cakephp-upload": "^8.0",
        "mobiledetect/mobiledetectlib": "^3.74",
        "braintree/braintree_php": "^6.40",
        "twilio/sdk": "^8.13",
        "directorytree/ldaprecord": "^3.8",
        "jumbojett/openid-connect-php": "^1.0.2",
        "guzzlehttp/guzzle": "^7.9",
        "ext-dom": "*"
    },
    "require-dev": {
        "cakephp/bake": "^3.0",
        "cakephp/cakephp-codesniffer": "^5.0",
        "cakephp/debug_kit": "^5.0",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Dms\\Kit\\": "src/Kit/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/"
        }
    },
    "scripts": {
        "unit": "phpunit -c phpunit.xml.dist",
        "cs": "phpcs -p --extensions=php --standard=vendor/cakephp/cakephp-codesniffer/CakePHP ./src ./tests",
        "test": [
            "@unit",
            "@cs"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
