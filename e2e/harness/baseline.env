# Synthetic, committable environment for the baseline harness. No real hostnames, keys or addresses.
# Every variable named in .docker/environment.conf is defined here so Apache never passes a literal "${VAR}".
DEBUG=false
APP_SECURITY_SALT=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HOSTNAME=app

DB_HOST=db
DB_DATABASE=dms_calendar
DB_USERNAME=calendar
DB_PASSWORD=calendar

AD_SERVER=ldap
AD_BASE=dc=dms,dc=local
AD_SUFFIX=@dms.local
AD_BIND_UN=cn=admin,dc=dms,dc=local
AD_BIND_PW=Adm1n!
AD_USE_TLS=true
# Dev OpenLDAP uses a self-signed certificate; keep the StartTLS code path but accept it.
LDAPTLS_REQCERT=never

# Braintree 'development' env makes the SDK talk to http://localhost:$GATEWAY_PORT (the fake gateway).
BRAINTREE_ENV=development
GATEWAY_PORT=3000
BRAINTREE_MERCHID=fake-merchant
BRAINTREE_PUBKEY=fake-public
BRAINTREE_PRIVKEY=fake-private

SPARKPOST_APIKEY=
TWILIO_ACCTSID=
TWILIO_AUTHTOKEN=
TWILIO_PHONENUM=

EMAIL_HOST=mail
EMAIL_PORT=1025
EMAIL_TIMEOUT=30
EMAIL_TLS=false

WEBHOOK_TARGETS='[{"name":"sink","url":"http://localhost:4010/webhook","secret":"test-secret"}]'
WEBHOOK_TIMEOUT=5

BASE_URL=http://app
OIDC_CLIENT_ID=calendar
OIDC_CLIENT_SECRET=dummy-secret-for-dev-mode
OIDC_URL_AUTHORIZE=http://keycloak:8080/realms/DMS/
OIDC_URL_ACCESS_TOKEN=http://keycloak:8080/token
OIDC_URL_RESOURCE_OWNER=http://keycloak:8080/realms/DMS/protocol/openid-connect/userinfo
